# JALDRISHTI backend credentials — TEMPLATE.
# Copy to backend/.env and fill in. backend/.env is gitignored; this file is not.
# Nothing here is read at import time; only the drivers/services that need a
# credential load it (scripts/run_sar_observation.py loads this via python-dotenv).

# --- Google Earth Engine (Sentinel-1 SAR flood observation) ---------------- #
# The Cloud project registered with Earth Engine. Run `earthengine authenticate`
# once (interactive, provisions local credentials); this only supplies the
# project id ee.Initialize() needs. Not a secret.
EE_PROJECT=your-ee-cloud-project-id

# --- Supabase (run store — wired in the next phase) ------------------------ #
# Project URL and keys from the Supabase dashboard (Settings -> API).
# SUPABASE_SERVICE_ROLE_KEY is SECRET — server-side only, never ship to a client.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

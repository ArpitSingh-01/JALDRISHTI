# ---- data & outputs (large binaries, never commit) ----
# Leading slash ANCHORS these to the repo root. Without it, `data/` would match a
# directory named `data` at ANY depth — silently swallowing tests/data/,
# jaldrishti/data/, frontend/data/ and so on. That failure mode is invisible:
# `git add` simply does nothing and you find out much later.
/data/*
/outputs/*
# Negations must target contents, not the directory itself. If `/data/` were
# ignored outright, git would never descend into it and `!/data/.gitkeep` could
# never match. Ignoring `/data/*` keeps the directory visible so this works.
!/data/.gitkeep
!/outputs/.gitkeep

# The backend writes its run directories to backend/outputs/, which the root
# anchor above does NOT match — that is the whole point of the anchor, and the
# cost of it. `scenario/run.py` writes one directory per simulation run, and a
# single run is ~50 files: report.pdf, five KMZs, figure PNGs, metadata.json,
# MANIFEST.json, README.txt and the QGIS .qml styles. None of those are caught
# by the format patterns below, so without this rule every run you do lands in
# `git status` and eventually in a commit.
/backend/outputs/*
!/backend/outputs/.gitkeep

# large geospatial / simulation binaries, wherever they land
*.tif
*.tiff
*.vrt
*.hgt
*.zip
*.kmz
*.nc
*.slf
*.tsh

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
/env/
.conda/

# ---- secrets ----
.env
*.credentials
service-account*.json
*-privatekey.json

# ---- node / frontend ----
node_modules/
.next/
out/
dist/

# ---- local tooling state (personal, not project source) ----
.claude/settings.local.json

# ---- os / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
